// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // native = local dev; rhel-openssl-3.0.x = Vercel serverless functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Asset {
  symbol       String        @id
  name         String?
  type         String        @default("STOCK") // STOCK, CRYPTO, ETF
  transactions Transaction[]

  // Phase 2: Wealth Diversification Fields
  interestRate Float?    // For Deposits (e.g., 2.5 for 2.5% TAN)
  maturityDate DateTime? // For Deposits
  bankName     String?   // For Deposits ("Santander", "CGD")
  isTaxAdvantaged Boolean @default(false) // For Pensions/PPR
  manualPrice     Float?   // For Manual Assets (Pensions): Current Unit Price
  lastPrice       Float?   // Cache for current market price
  lastCurrency    String?  // Cache for market currency (USD, EUR, etc.)
  lastUpdate      DateTime? // When the cache was last updated
}
model Transaction {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [symbol])
  type      String // BUY, SELL
  currency  String   @default("USD") // USD, EUR
  quantity  Float
  price     Float // Price per share
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model HistoricalPrice {
  id        String   @id @default(uuid())
  symbol    String
  date      DateTime // normalized to end of month/day
  price     Float
  currency  String

  @@unique([symbol, date])
}

model Setting {
  key   String @id
  value String
}
